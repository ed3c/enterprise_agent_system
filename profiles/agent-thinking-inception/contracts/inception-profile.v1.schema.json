{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://enterprise-agent-system.invalid/profiles/agent-thinking-inception/contracts/inception-profile.v1.schema.json",
  "title": "Agent Thinking Inception integration profile v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profile_id",
    "source_subject_id",
    "source_digest",
    "requirement_document",
    "contradiction_document",
    "owner_repositories",
    "state",
    "evidence_ceiling",
    "next_issues"
  ],
  "properties": {
    "schema_version": {"const": "enterprise-agent-system/inception-profile/v1"},
    "profile_id": {"const": "PROFILE-AGENT-THINKING-INCEPTION-001"},
    "source_subject_id": {"const": "SRC-PDF-INCEPTION-001"},
    "source_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "requirement_document": {"type": "string", "pattern": "^profiles/agent-thinking-inception/requirements/"},
    "contradiction_document": {"type": "string", "pattern": "^profiles/agent-thinking-inception/requirements/"},
    "owner_repositories": {
      "type": "array",
      "minItems": 6,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^ed3c/"}
    },
    "state": {
      "enum": ["SOURCE_REGISTERED", "REQUIREMENTS_COMPILED", "PROFILE_CONTRACT_READY", "OWNER_LANES_BOUND", "BLOCKED"]
    },
    "evidence_ceiling": {"const": "SOURCE_AND_CONTRACT_CANDIDATE_ONLY"},
    "next_issues": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^#[0-9]+$"}
    }
  }
}
