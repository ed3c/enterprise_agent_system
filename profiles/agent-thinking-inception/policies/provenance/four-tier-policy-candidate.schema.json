{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/enterprise-agent-system/inception-four-tier-policy-candidate.v1.schema.json",
  "title": "Inception Four-Tier Policy Candidate",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "candidate_id", "dimensions", "overall_state", "claims_not_proven"],
  "properties": {
    "schema_version": {"const": "enterprise-agent-system/inception-four-tier-policy-candidate/v1"},
    "candidate_id": {"type": "string", "minLength": 1},
    "dimensions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "model", "data", "trace"],
      "properties": {
        "code": {"$ref": "#/$defs/dimension"},
        "model": {"$ref": "#/$defs/dimension"},
        "data": {"$ref": "#/$defs/dimension"},
        "trace": {"$ref": "#/$defs/dimension"}
      }
    },
    "overall_state": {"enum": ["CANDIDATE", "BLOCKED", "UNKNOWN", "HUMAN_REVIEW_REQUIRED", "EXPIRED"]},
    "claims_not_proven": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "dimension": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subject", "version", "content_digest", "terms_digest", "obligations", "blockers", "expiry_trigger", "policy_state", "human_review_subject"],
      "properties": {
        "subject": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "content_digest": {"$ref": "#/$defs/sha256"},
        "terms_digest": {"$ref": "#/$defs/sha256"},
        "obligations": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "blockers": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "expiry_trigger": {"type": "string", "minLength": 1},
        "policy_state": {"enum": ["CANDIDATE", "BLOCKED", "UNKNOWN", "HUMAN_REVIEW_REQUIRED", "EXPIRED"]},
        "human_review_subject": {"type": ["string", "null"]}
      }
    }
  }
}
