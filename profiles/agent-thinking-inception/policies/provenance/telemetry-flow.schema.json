{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/enterprise-agent-system/inception-telemetry-flow.v1.schema.json",
  "title": "Inception Telemetry Flow Candidate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "flow_id",
    "classification",
    "payload_classes",
    "redacted_fields",
    "dropped_fields",
    "stages",
    "collector",
    "exporter",
    "storage",
    "access_policy",
    "retention",
    "deletion_policy",
    "training_use_policy",
    "negative_controls",
    "state",
    "claims_not_proven"
  ],
  "properties": {
    "schema_version": {"const": "enterprise-agent-system/inception-telemetry-flow/v1"},
    "flow_id": {"type": "string", "minLength": 1},
    "classification": {"enum": ["PUBLIC", "INTERNAL", "CONFIDENTIAL", "RESTRICTED"]},
    "payload_classes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["PUBLIC", "INTERNAL", "CONFIDENTIAL", "RESTRICTED", "SECRET", "PII", "PROPRIETARY_SOURCE", "PROMPT_CONTENT"]}
    },
    "redacted_fields": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "dropped_fields": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "stages": {
      "type": "array",
      "minItems": 6,
      "uniqueItems": true,
      "items": {"enum": ["CLASSIFY", "SANITIZE", "NEGATIVE_LEAK_CONTROLS", "EXPORT", "STORE", "DELETE"]}
    },
    "collector": {"$ref": "#/$defs/component"},
    "exporter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subject", "version", "config_digest", "allowlisted_destination"],
      "properties": {
        "subject": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "config_digest": {"$ref": "#/$defs/sha256"},
        "allowlisted_destination": {"type": "string", "minLength": 1}
      }
    },
    "storage": {"$ref": "#/$defs/component"},
    "access_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rbac_roles", "tenant_scope"],
      "properties": {
        "rbac_roles": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "tenant_scope": {"type": "string", "minLength": 1}
      }
    },
    "retention": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy_id", "duration", "delete_after_retention"],
      "properties": {
        "policy_id": {"type": "string", "minLength": 1},
        "duration": {"type": "string", "minLength": 1},
        "delete_after_retention": {"const": true}
      }
    },
    "deletion_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "receipt_required", "rebuild_behavior"],
      "properties": {
        "mode": {"enum": ["DELETE", "TOMBSTONE_THEN_DELETE", "REBUILD_WITHOUT_SUBJECT"]},
        "receipt_required": {"const": true},
        "rebuild_behavior": {"type": "string", "minLength": 1}
      }
    },
    "training_use_policy": {"enum": ["PROHIBITED", "HUMAN_REVIEW_REQUIRED", "UNKNOWN"]},
    "negative_controls": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["control_id", "assertion", "evidence_lane", "expected_result"],
        "properties": {
          "control_id": {"type": "string", "minLength": 1},
          "assertion": {"type": "string", "minLength": 1},
          "evidence_lane": {"enum": ["DETERMINISTIC_FIXTURE", "LOCAL_LIVE", "PROVIDER_LIVE", "PHYSICAL"]},
          "expected_result": {"enum": ["REFUSE", "REDACT", "DROP", "BLOCK_EXPORT"]}
        }
      }
    },
    "state": {"enum": ["CANDIDATE", "BLOCKED", "UNKNOWN", "HUMAN_REVIEW_REQUIRED", "EXPIRED"]},
    "claims_not_proven": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subject", "version", "config_digest"],
      "properties": {
        "subject": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "config_digest": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
