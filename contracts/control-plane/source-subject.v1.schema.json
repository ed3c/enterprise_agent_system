{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://enterprise-agent-system.invalid/contracts/control-plane/source-subject.v1.schema.json",
  "title": "Enterprise Agent System Source Subject v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "subject_id",
    "source_kind",
    "locator",
    "identity",
    "data_class",
    "egress_allowed",
    "captured_at",
    "content_digest",
    "claims_not_proven"
  ],
  "properties": {
    "schema_version": {"const": "enterprise-agent-system/source-subject/v1"},
    "subject_id": {"type": "string", "pattern": "^SRC-[A-Z0-9][A-Z0-9._-]*$"},
    "source_kind": {"enum": ["SOURCE_PROPOSAL", "CURRENT_FACT", "CONTRACT", "RECEIPT"]},
    "locator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "url"],
      "properties": {
        "provider": {"enum": ["GITHUB", "GOOGLE_DOC", "GOOGLE_SHEET", "FILE", "OTHER"]},
        "url": {"type": "string", "minLength": 1},
        "navigation_ref": {"type": "string"}
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identity_kind"],
      "properties": {
        "identity_kind": {"enum": ["GIT", "REVISION", "CONTENT_ONLY"]},
        "repository": {"type": "string", "pattern": "^[^/\\s]+/[^/\\s]+$"},
        "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "tree": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "revision": {"type": "string", "minLength": 1}
      }
    },
    "data_class": {"enum": ["PUBLIC", "INTERNAL", "CONFIDENTIAL", "LOCAL_ONLY"]},
    "egress_allowed": {"type": "boolean"},
    "captured_at": {"type": "string", "format": "date-time"},
    "content_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "claims_not_proven": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
  }
}
