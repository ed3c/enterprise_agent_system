{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ed3c/enterprise_agent_system/handoff/local-handoff-receipt.schema.json",
  "title": "EAS Local Handoff Receipt v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "queue_id",
    "item_id",
    "started_at",
    "finished_at",
    "subject_before",
    "subject_after",
    "commands",
    "exit_codes",
    "stdout_digests",
    "stderr_digests",
    "observed_commit",
    "observed_tree",
    "evidence_lane",
    "result",
    "dirty_state_before",
    "dirty_state_after",
    "residue_inventory",
    "cleanup_result",
    "failures",
    "retries",
    "claims_not_proven",
    "next_transition"
  ],
  "properties": {
    "schema_version": {"const": "enterprise-agent-system/local-handoff-receipt/v2"},
    "queue_id": {"type": "string", "minLength": 1},
    "item_id": {"type": "string", "minLength": 1},
    "started_at": {"type": "string", "format": "date-time"},
    "finished_at": {"type": "string", "format": "date-time"},
    "subject_before": {"$ref": "#/$defs/subject"},
    "subject_after": {"$ref": "#/$defs/subject"},
    "commands": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "exit_codes": {"type": "array", "items": {"type": "integer"}},
    "stdout_digests": {"type": "array", "items": {"$ref": "#/$defs/digest"}},
    "stderr_digests": {"type": "array", "items": {"$ref": "#/$defs/digest"}},
    "observed_commit": {"$ref": "#/$defs/sha40"},
    "observed_tree": {"$ref": "#/$defs/sha40"},
    "evidence_lane": {"type": "string", "minLength": 1},
    "result": {"enum": ["PASS", "FAIL", "BLOCKED", "NOT_EXERCISED", "UNKNOWN_EFFECT", "HUMAN_ADMIT_REQUIRED"]},
    "dirty_state_before": {"type": "string"},
    "dirty_state_after": {"type": "string"},
    "residue_inventory": {"type": "object"},
    "cleanup_result": {"enum": ["PASS", "FAIL", "NOT_REQUIRED", "NOT_EXERCISED"]},
    "failures": {"type": "array", "items": {"type": "object"}},
    "retries": {"type": "array", "items": {"type": "object"}},
    "effect_state": {"enum": ["NOT_APPLICABLE", "NOT_PERFORMED", "RESERVED", "UNKNOWN_EFFECT", "COMMITTED", "COMPENSATED", "FAILED"]},
    "readback_state": {"enum": ["NOT_APPLICABLE", "NOT_PERFORMED", "MATCH", "MISMATCH", "UNKNOWN"]},
    "compensation_state": {"enum": ["NOT_APPLICABLE", "NOT_PERFORMED", "PASS", "FAIL", "UNKNOWN"]},
    "claims_not_proven": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "next_transition": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "sha40": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "commit", "tree"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "commit": {"$ref": "#/$defs/sha40"},
        "tree": {"$ref": "#/$defs/sha40"}
      }
    }
  }
}
